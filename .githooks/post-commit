#!/bin/sh
# EWTGuide post-commit hook: Auto-push to origin to trigger Vercel deployment

# Do not push during intermediate rebase steps
if [ -d "$GIT_DIR/rebase-merge" ] || [ -d "$GIT_DIR/rebase-apply" ]; then
  exit 0
fi

current_branch=$(git symbolic-ref --short HEAD 2>/dev/null)

if [ -z "$current_branch" ]; then
  exit 0
fi

echo ""
echo "🚀 [Auto-Deploy] 'git commit' 완료 감지!"
echo "📡 Vercel 자동 배포를 위해 GitHub origin/$current_branch 로 푸시를 진행합니다..."

git push origin "$current_branch"

if [ $? -eq 0 ]; then
  echo "✅ [Auto-Deploy] GitHub 푸시 성공! Vercel에서 배포가 자동 시작됩니다."
  echo "🌐 라이브 주소: https://ewtguide.vercel.app"
else
  echo "⚠️ [Auto-Deploy] 푸시 중 문제가 발생했습니다. 수동으로 'git push origin $current_branch'를 실행해 주세요."
fi
echo ""
